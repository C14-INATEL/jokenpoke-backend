# Application

APP_NAME=Jokenpoke Game API
APP_ENV=development
APP_DEBUG=true

# API

API_HOST=0.0.0.0
API_PORT=8000

# Database

DB_HOST=db
DB_PORT=5432
DB_NAME=jokenpoke
DB_USER=postgres
DB_PASSWORD=postgres

# SQLAlchemy connection string
DATABASE_URL=postgresql://postgres:postgres@db:5432/jokenpoke

# Authentication (JWT)

JWT_SECRET_KEY=change-this-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Game configuration

INITIAL_CARDS_PER_USER=6
DECK_SIZE=3
BATTLE_ROUNDS=3

# Ranking points
RANKING_WIN_POINTS=30
RANKING_LOSS_POINTS=-10
RANKING_DRAW_POINTS=0